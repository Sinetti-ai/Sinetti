# These variables are not auto-loaded. Export them to the shell before
# running a deploy script, e.g. `set -a; source .env; set +a`. See docs/deploy.md.

# Required off hardhat/localhost. Testnet-only throwaway key; never a mainnet key.
DEPLOYER_PRIVATE_KEY=
# RPC endpoint for the sepolia network. Falls back to a public RPC if unset.
SEPOLIA_RPC_URL=
# Used only by `forge verify-contract` / the etherscan config; not required to deploy.
ETHERSCAN_API_KEY=

# Required on non-local networks. The pauser needs no capability signature.
PAUSER_ADDRESS=

# Settlement token for the escrow's single TokenPolicy entry.
TOKEN_ADDRESS=
# Optional base-unit caps; default to uint256 max (uncapped) when unset.
TOKEN_MAX_AMOUNT=
TOKEN_MAX_BOND=
# Required. Set 0 deliberately only when zero-bond deals are intended.
TOKEN_MIN_BOND_BPS=
# Required challenger-bond floor in basis points of the escrow amount (max 10000).
# 0 is legal and deliberately preserves gas-only challenge deterrence.
TOKEN_MIN_CHALLENGER_BOND_BPS=

# Required per-deployment window floors in seconds, each between 60 and the
# contract's hard ceiling (30 days challenge, 90 days ruling).
MIN_CHALLENGE_WINDOW_SECONDS=
MIN_RULING_WINDOW_SECONDS=

# Comma-separated EVM addresses. Empty means open enrollment (any address may
# take that role). A restricted list needs at least 3 participants.
PARTICIPANT_ALLOWLIST=
# Comma-separated arbitrator contract addresses the escrow admits. Empty
# means open enrollment (any contract with code may arbitrate a deal).
ARBITRATOR_ALLOWLIST=

# ConsoleArbitrator constructor arguments. All three required.
ARBITRATOR_AGENT_KEY=
ARBITRATOR_OFFICER=
# Seconds, between 1 day (86400) and 30 days (2592000).
ARBITRATOR_OVERRIDE_WINDOW_SECONDS=
